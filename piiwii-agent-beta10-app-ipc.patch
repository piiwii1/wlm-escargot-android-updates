+
+static bool isPiiWiiTvAppAction(const std::string& action) {
+    static const std::set<std::string> allowed = {
+        "power", "direct", "channel_up", "channel_down", "volume_up", "volume_down", "mute",
+        "play_pause", "seek_back", "seek_forward", "record", "guide", "recordings", "radio",
+        "settings", "home", "nav_up", "nav_down", "nav_left", "nav_right", "nav_ok", "back",
+        "fullscreen", "browser_fullscreen", "windowed"
+    };
+    return allowed.find(action) != allowed.end();
+}
+
+static BOOL CALLBACK findPiiWiiTvAppWindowProc(HWND hwnd, LPARAM param) {
+    auto* result = reinterpret_cast<HWND*>(param);
+    if (!result || !IsWindow(hwnd)) return TRUE;
+    DWORD pid = 0;
+    GetWindowThreadProcessId(hwnd, &pid);
+    if (!pid) return TRUE;
+    HANDLE process = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid);
+    if (!process) return TRUE;
+    wchar_t path[MAX_PATH * 4]{};
+    DWORD size = static_cast<DWORD>(std::size(path));
+    const BOOL ok = QueryFullProcessImageNameW(process, 0, path, &size);
+    CloseHandle(process);
+    if (!ok || size == 0) return TRUE;
+    std::wstring exe(path, size);
+    const auto slash = exe.find_last_of(L"\\/");
+    if (slash != std::wstring::npos) exe = exe.substr(slash + 1);
+    std::transform(exe.begin(), exe.end(), exe.begin(), ::towlower);
+    if (exe != L"piiwiitv.exe") return TRUE;
+    *result = hwnd;
+    return FALSE;
+}
+
+static HWND findPiiWiiTvAppWindow() {
+    HWND target = nullptr;
+    EnumWindows(findPiiWiiTvAppWindowProc, reinterpret_cast<LPARAM>(&target));
+    return target;
+}
+
+static bool sendPiiWiiTvAppAction(const std::string& action) {
+    if (!isPiiWiiTvAppAction(action)) return false;
+    HWND target = findPiiWiiTvAppWindow();
+    if (!target) {
+        const std::wstring exe = readRegString(HKEY_CURRENT_USER, L"Software\\PiiWii\\PiiWiiTV", L"InstallPath");
+        if (exe.empty() || GetFileAttributesW(exe.c_str()) == INVALID_FILE_ATTRIBUTES) return false;
+        const std::wstring params = L"--action=" + utf8ToWide(action);
+        HINSTANCE launched = ShellExecuteW(nullptr, L"open", exe.c_str(), params.c_str(), nullptr, SW_SHOWNORMAL);
+        return reinterpret_cast<INT_PTR>(launched) > 32;
+    }
+
+    std::string payload = action;
+    payload.push_back('\0');
+    COPYDATASTRUCT cds{};
+    cds.dwData = static_cast<ULONG_PTR>(0x50545731); // PTW1
+    cds.cbData = static_cast<DWORD>(payload.size());
+    cds.lpData = payload.data();
+    DWORD_PTR result = 0;
+    return SendMessageTimeoutW(target, WM_COPYDATA, 0, reinterpret_cast<LPARAM>(&cds),
+        SMTO_ABORTIFHUNG | SMTO_BLOCK, 1500, &result) != 0;
+}
