+    private void applyLandscapeReferenceGeometry() {
+        if (getResources().getConfiguration().orientation != android.content.res.Configuration.ORIENTATION_LANDSCAPE) return;
+        if (safeContent == null || previewFrame == null || topPanel == null || bottomPanel == null) return;
+        int w = safeContent.getWidth();
+        int h = safeContent.getHeight();
+        if (w <= 0 || h <= 0) return;
+
+        // Samsung-style geometry: slim black tools rail + full-height 4:3 photo frame + black capture dock.
+        int leftRail = dp(52);
+        int minimumDock = dp(176);
+        int preferredPreview = Math.round(h * 4f / 3f);
+        int maxPreview = Math.max(dp(240), w - leftRail - minimumDock);
+        int previewWidth = Math.min(preferredPreview, maxPreview);
+        int dockWidth = Math.max(minimumDock, w - leftRail - previewWidth);
+
+        android.widget.FrameLayout.LayoutParams pp = (android.widget.FrameLayout.LayoutParams) previewFrame.getLayoutParams();
+        pp.width = previewWidth;
+        pp.height = android.widget.FrameLayout.LayoutParams.MATCH_PARENT;
+        pp.leftMargin = leftRail;
+        pp.rightMargin = 0;
+        pp.gravity = android.view.Gravity.START | android.view.Gravity.TOP;
+        previewFrame.setLayoutParams(pp);
+
+        android.widget.FrameLayout.LayoutParams tp = (android.widget.FrameLayout.LayoutParams) topPanel.getLayoutParams();
+        tp.width = leftRail;
+        tp.height = android.widget.FrameLayout.LayoutParams.MATCH_PARENT;
+        tp.leftMargin = 0;
+        tp.gravity = android.view.Gravity.START | android.view.Gravity.TOP;
+        topPanel.setLayoutParams(tp);
+
+        android.widget.FrameLayout.LayoutParams bp = (android.widget.FrameLayout.LayoutParams) bottomPanel.getLayoutParams();
+        bp.width = dockWidth;
+        bp.height = android.widget.FrameLayout.LayoutParams.MATCH_PARENT;
+        bp.gravity = android.view.Gravity.END | android.view.Gravity.TOP;
+        bottomPanel.setLayoutParams(bp);
+
+        previewView.setScaleType(PreviewView.ScaleType.FIT_CENTER);
+    }
