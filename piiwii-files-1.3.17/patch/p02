+    private void collectOldFiles(File dir, ArrayList<File> out, long before, int limit) {
+        if (dir == null || out.size() >= limit) return;
+        File[] children;
+        try { children = dir.listFiles(); } catch (Exception e) { return; }
+        if (children == null) return;
+        for (File f : children) {
+            if (out.size() >= limit) return;
+            if (f.isDirectory()) collectOldFiles(f, out, before, limit);
+            else if (f.lastModified() > 0 && f.lastModified() < before) out.add(f);
+        }
+    }
