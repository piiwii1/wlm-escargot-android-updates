+    private ArrayList<File> queryIndexedBySuffixes(String[] suffixes, int limit) {
+        LinkedHashMap<String, File> unique = new LinkedHashMap<>();
+        StringBuilder sel = new StringBuilder();
+        ArrayList<String> args = new ArrayList<>();
+        for (String suffix : suffixes) {
+            if (sel.length() > 0) sel.append(" OR ");
+            sel.append(MediaStore.MediaColumns.DISPLAY_NAME).append(" LIKE ?");
+            args.add("%" + suffix);
+        }
+        for (String volume : mediaVolumes()) {
+            addIndexedFiles(MediaStore.Files.getContentUri(volume), sel.toString(), args.toArray(new String[0]), unique, limit, MediaStore.MediaColumns.DATE_MODIFIED + " DESC");
+            if (unique.size() >= limit) break;
+        }
+        return new ArrayList<>(unique.values());
+    }
