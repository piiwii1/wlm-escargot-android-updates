+    private ArrayList<File> findAlreadyInstalledApks() {
+        ArrayList<File> result = new ArrayList<>();
+        PackageManager pm = getPackageManager();
+        for (File apk : queryIndexedFiles(3, 400)) {
+            try {
+                PackageInfo archive = pm.getPackageArchiveInfo(apk.getAbsolutePath(), 0);
+                if (archive == null || archive.packageName == null) continue;
+                PackageInfo installed = pm.getPackageInfo(archive.packageName, 0);
+                long archiveCode = Build.VERSION.SDK_INT >= 28 ? archive.getLongVersionCode() : archive.versionCode;
+                long installedCode = Build.VERSION.SDK_INT >= 28 ? installed.getLongVersionCode() : installed.versionCode;
+                if (installedCode >= archiveCode) result.add(apk);
+            } catch (Exception ignored) { }
+        }
+        return result;
+    }
