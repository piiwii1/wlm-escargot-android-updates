+struct VoiceAudioBlock {
+    std::vector<char> pcm;
+    WAVEHDR header{};
+};
+
+static std::mutex gVoiceMutex;
+static HWAVEOUT gVoiceOut = nullptr;
+static std::deque<std::unique_ptr<VoiceAudioBlock>> gVoiceBlocks;
+
+static void clearVoiceBlocksLocked(bool resetDevice) {
+    if (!gVoiceOut) {
+        gVoiceBlocks.clear();
+        return;
+    }
+    if (resetDevice) waveOutReset(gVoiceOut);
+    for (auto& block : gVoiceBlocks) {
+        if (block->header.dwFlags & WHDR_PREPARED) {
+            waveOutUnprepareHeader(gVoiceOut, &block->header, sizeof(WAVEHDR));
+        }
+    }
+    gVoiceBlocks.clear();
+}
+
+static void reapVoiceBlocksLocked() {
+    while (!gVoiceBlocks.empty()) {
+        auto& block = gVoiceBlocks.front();
+        if ((block->header.dwFlags & WHDR_DONE) == 0) break;
+        waveOutUnprepareHeader(gVoiceOut, &block->header, sizeof(WAVEHDR));
+        gVoiceBlocks.pop_front();
+    }
+}
+
+static bool startVoicePlaybackLocked() {
+    if (gVoiceOut) return true;
+    WAVEFORMATEX fmt{};
+    fmt.wFormatTag = WAVE_FORMAT_PCM;
+    fmt.nChannels = 1;
+    fmt.nSamplesPerSec = 16000;
+    fmt.wBitsPerSample = 16;
+    fmt.nBlockAlign = static_cast<WORD>(fmt.nChannels * fmt.wBitsPerSample / 8);
+    fmt.nAvgBytesPerSec = fmt.nSamplesPerSec * fmt.nBlockAlign;
+    fmt.cbSize = 0;
+    return waveOutOpen(&gVoiceOut, WAVE_MAPPER, &fmt, 0, 0, CALLBACK_NULL) == MMSYSERR_NOERROR;
+}
+
+static bool startVoicePlayback() {
+    std::lock_guard<std::mutex> lock(gVoiceMutex);
+    return startVoicePlaybackLocked();
+}
+
+static bool decodeVoiceFramePayload(const std::string& payload, std::string& pcm) {
+    const size_t separator = payload.find('|');
+    if (separator == std::string::npos || separator == 0 || separator + 1 >= payload.size()) return false;
+    if (!std::all_of(payload.begin(), payload.begin() + static_cast<std::ptrdiff_t>(separator), [](unsigned char c){ return std::isdigit(c) != 0; })) return false;
+    if (!base64Decode(payload.substr(separator + 1), pcm)) return false;
+    return !pcm.empty() && pcm.size() <= 1024 && (pcm.size() % 2) == 0;
+}
+
+static bool playVoiceFrame(const std::string& payload) {
+    std::string pcm;
+    if (!decodeVoiceFramePayload(payload, pcm)) return false;
+    std::lock_guard<std::mutex> lock(gVoiceMutex);
+    if (!startVoicePlaybackLocked()) return false;
+    reapVoiceBlocksLocked();
+    if (gVoiceBlocks.size() > 25) clearVoiceBlocksLocked(true); // keep latency below ~0.5 s
+
+    auto block = std::make_unique<VoiceAudioBlock>();
+    block->pcm.assign(pcm.begin(), pcm.end());
+    block->header.lpData = block->pcm.data();
+    block->header.dwBufferLength = static_cast<DWORD>(block->pcm.size());
+    if (waveOutPrepareHeader(gVoiceOut, &block->header, sizeof(WAVEHDR)) != MMSYSERR_NOERROR) return false;
+    if (waveOutWrite(gVoiceOut, &block->header, sizeof(WAVEHDR)) != MMSYSERR_NOERROR) {
+        waveOutUnprepareHeader(gVoiceOut, &block->header, sizeof(WAVEHDR));
+        return false;
+    }
+    gVoiceBlocks.push_back(std::move(block));
+    return true;
+}
+
+static bool stopVoicePlayback() {
+    std::lock_guard<std::mutex> lock(gVoiceMutex);
+    if (!gVoiceOut) return true;
+    clearVoiceBlocksLocked(true);
+    const MMRESULT result = waveOutClose(gVoiceOut);
+    gVoiceOut = nullptr;
+    return result == MMSYSERR_NOERROR;
+}
