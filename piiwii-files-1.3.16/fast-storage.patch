+    private void applyStorageTypeSizes(TextView[] values, long[] sizes) {
+        if (values == null || sizes == null) return;
+        for (int i = 0; i < values.length && i < sizes.length; i++) {
+            if (values[i] != null) values[i].setText(FileUtils.formatSize(Math.max(0L, sizes[i])));
+        }
+    }
+
+    private long[] loadCachedStorageTypeSizes() {
+        SharedPreferences p = getSharedPreferences("storage_type_cache", MODE_PRIVATE);
+        if (!p.getBoolean("ready", false)) return null;
+        return new long[]{
+                p.getLong("photos", 0L),
+                p.getLong("videos", 0L),
+                p.getLong("music", 0L),
+                p.getLong("apk", 0L)
+        };
+    }
+
+    private void saveCachedStorageTypeSizes(long[] sizes) {
+        if (sizes == null || sizes.length < 4) return;
+        getSharedPreferences("storage_type_cache", MODE_PRIVATE).edit()
+                .putBoolean("ready", true)
+                .putLong("photos", sizes[0])
+                .putLong("videos", sizes[1])
+                .putLong("music", sizes[2])
+                .putLong("apk", sizes[3])
+                .apply();
     }
 
