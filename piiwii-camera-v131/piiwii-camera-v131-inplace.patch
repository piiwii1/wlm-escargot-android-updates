+            if (rebindWhenReady) bindUseCases();
+            return;
+        }
+        if (extensionsInitStarted) return;
+        extensionsInitStarted = true;
+        try {
+            ListenableFuture<ExtensionsManager> future =
+                    ExtensionsManager.getInstanceAsync(getApplicationContext(), cameraProvider);
+            future.addListener(() -> {
+                extensionsInitStarted = false;
+                try {
+                    extensionsManager = future.get();
+                    statusLabel.setText("Moteur OEM prêt");
+                } catch (Exception e) {
+                    extensionsManager = null;
+                    statusLabel.setText("OEM indisponible · mode natif");
+                }
+                if (rebindWhenReady && !isFinishing() && !isDestroyed()) bindUseCases();
+            }, ContextCompat.getMainExecutor(this));
+        } catch (Exception e) {
+            extensionsInitStarted = false;
+            extensionsManager = null;
+            statusLabel.setText("OEM indisponible · mode natif");
+            if (rebindWhenReady) bindUseCases();
+        }
+    }
