+    private void forceStableStartupState() {
+        // Preserve signatures and UI preferences, but reset camera states that can crash vendor stacks.
+        photoMode = true;
+        qualityMode = QUALITY_OEM_AUTO;
+        photoResolutionMode = RES_12MP;
+        lowLightBoostRequested = false;
+        videoHdrRequested = false;
+        selectedPhysicalCameraId = null;
+        selectedPhysicalBaseZoom = 1f;
+        pendingWorldZoom = 1f;
+        safeStartupBind = true;
+        prefs.edit()
+                .putBoolean("photoMode", true)
+                .putInt("quality", QUALITY_OEM_AUTO)
+                .putInt("photoResolution", RES_12MP)
+                .putBoolean("lowLightBoost", false)
+                .putBoolean("videoHdr", false)
+                .apply();
+    }
+
+    private void markStartupStableSoon() {
+        if (root == null || prefs == null) return;
+        root.removeCallbacks(markStartupStableRunnable);
+        root.postDelayed(markStartupStableRunnable, 1800);
+    }
+
+    private final Runnable markStartupStableRunnable = () -> {
+        if (prefs != null) prefs.edit().putBoolean(PREF_STARTUP_PENDING, false).apply();
+        startupRecoveryMode = false;
+    };
+
+    private String safeMessage(Throwable t) {
+        if (t == null) return "erreur inconnue";
+        String m = t.getMessage();
+        if (m == null || m.trim().isEmpty()) return t.getClass().getSimpleName();
+        return m;
+    }
