@@ -3,6 +3,16 @@
     id("org.jetbrains.kotlin.android")
 }
 
+
+// Live Event Widget icon generated for 1.4.0 icon refresh.
+// Decoded at configuration time so Android resources see the PNG before compilation.
+val liveEventIconSource = System.getenv("GITHUB_WORKSPACE")?.let { file("$it/.piiwii-events-141/icon.b64") }
+if (liveEventIconSource != null && liveEventIconSource.exists()) {
+    val liveEventIconOut = file("src/main/res/drawable-nodpi/ic_launcher_art.png")
+    liveEventIconOut.parentFile.mkdirs()
+    liveEventIconOut.writeBytes(java.util.Base64.getDecoder().decode(liveEventIconSource.readText().trim()))
+}
