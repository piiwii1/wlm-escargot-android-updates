+    private ImageView iconTile(int iconRes, int accent, int sizeDp, int paddingDp) {
+        ImageView icon = new ImageView(this);
+        icon.setImageResource(iconRes);
+        icon.setScaleType(ImageView.ScaleType.CENTER_INSIDE);
+        icon.setPadding(dp(paddingDp), dp(paddingDp), dp(paddingDp), dp(paddingDp));
+        icon.setBackground(outlined(accent, Math.max(12, sizeDp / 4), Color.argb(58, 255, 255, 255)));
+        return icon;
+    }
+
+    private int storageIconFor(File rootFile) {
+        if (sameFile(rootFile, Environment.getExternalStorageDirectory())) return R.drawable.ic_storage_internal;
+        String path = rootFile == null ? "" : rootFile.getAbsolutePath().toLowerCase(Locale.ROOT);
+        if (path.contains("usb") || path.contains("udisk") || path.contains("otg")) return R.drawable.ic_storage_usb;
+        if (path.contains("sd") || path.contains("ext") || path.contains("external")) return R.drawable.ic_storage_sd;
+        return R.drawable.ic_storage_drive;
+    }
