+    private String shareTargetKey(ShareTarget target) {
+        return target.packageName + "/" + target.className;
+    }
+
+    private LinkedHashSet<String> loadShareFavoriteKeys(List<ShareTarget> targets) {
+        SharedPreferences p = prefs();
+        LinkedHashSet<String> keys = new LinkedHashSet<>();
+        String raw = p.getString("share_favorites_order", "");
+        if (raw != null && !raw.trim().isEmpty()) {
+            for (String key : raw.split("\\n")) if (!key.trim().isEmpty()) keys.add(key.trim());
+        }
+        if (!p.getBoolean("share_favorites_customized", false) && keys.isEmpty()) {
+            for (ShareTarget target : targets) if (target.priority < 10) keys.add(shareTargetKey(target));
+        }
+        return keys;
+    }
+
+    private void saveShareFavoriteKeys(Collection<String> keys) {
+        StringBuilder out = new StringBuilder();
+        for (String key : keys) {
+            if (key == null || key.trim().isEmpty()) continue;
+            if (out.length() > 0) out.append('\n');
+            out.append(key.trim());
+        }
+        prefs().edit()
+                .putString("share_favorites_order", out.toString())
+                .putBoolean("share_favorites_customized", true)
+                .apply();
+    }
