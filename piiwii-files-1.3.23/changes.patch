+    private void confirmCollectionDelete(ArrayList<File> files, LinkedHashSet<File> selectedFiles, FileAdapter collectionAdapter,
+                                         TextView infoText, LinearLayout collectionActions, Runnable updateSelection) {
+        if (selectedFiles == null || selectedFiles.isEmpty()) return;
+        ArrayList<File> doomed = new ArrayList<>(selectedFiles);
+        long bytes = totalSize(doomed);
+        new AlertDialog.Builder(this)
+                .setTitle("Supprimer " + doomed.size() + " fichier(s) ?")
+                .setMessage("Espace récupérable : " + FileUtils.formatSize(bytes) + "\nCette action est irréversible.")
+                .setPositiveButton("SUPPRIMER", (d,w) -> new Thread(() -> {
+                    int deleted = 0;
+                    long deletedBytes = 0L;
+                    for (File f : doomed) {
+                        if (f == null || !f.exists()) continue;
+                        long size = f.isFile() ? Math.max(0L, f.length()) : 0L;
+                        if (FileUtils.deleteRecursive(f)) { deleted++; deletedBytes += size; }
+                    }
+                    int finalDeleted = deleted;
+                    long finalDeletedBytes = deletedBytes;
+                    runOnUiThread(() -> {
+                        files.removeIf(f -> f == null || !f.exists());
+                        selectedFiles.clear();
+                        collectionAdapter.setFiles(files.toArray(new File[0]));
+                        collectionActions.setVisibility(View.GONE);
+                        infoText.setText(files.size() + (files.size() == 1 ? " fichier" : " fichiers") + "  •  Appui long pour sélectionner");
+                        updateSelection.run();
+                        Toast.makeText(this, finalDeleted + " fichier(s) supprimé(s)  •  " + FileUtils.formatSize(finalDeletedBytes) + " libérés", Toast.LENGTH_LONG).show();
+                    });
+                }, "PiiWiiFiles-collection-delete").start())
+                .setNegativeButton("ANNULER", null)
+                .show();
+    }
