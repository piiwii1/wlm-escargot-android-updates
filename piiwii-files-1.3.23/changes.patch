+    private ArrayList<File> queryCleanupBySuffixes(String[] suffixes, int limit, boolean includeOwnCaches) {
+        LinkedHashMap<String, File> unique = new LinkedHashMap<>();
+        addUniqueFiles(queryIndexedBySuffixes(suffixes, limit), unique, limit);
+
+        // Secours ciblé : on ne rescane jamais tout le stockage. On complète seulement
+        // les dossiers utilisateur habituels où MediaStore peut être incomplet.
+        collectTargetedBySuffixes(FileUtils.downloadsDir(), suffixes, 4, unique, limit);
+        collectTargetedBySuffixes(FileUtils.documentsDir(), suffixes, 3, unique, limit);
+        collectTargetedBySuffixes(Environment.getExternalStorageDirectory(), suffixes, 0, unique, limit);
+
+        if (includeOwnCaches) {
+            collectAllFilesBounded(getCacheDir(), 6, unique, limit);
+            try { collectAllFilesBounded(getExternalCacheDir(), 6, unique, limit); } catch (Exception ignored) { }
+        }
+        return new ArrayList<>(unique.values());
+    }
+
+    private void addUniqueFiles(Collection<File> files, LinkedHashMap<String, File> out, int limit) {
+        if (files == null) return;
+        for (File f : files) {
+            if (out.size() >= limit) return;
+            if (f != null && f.exists() && f.isFile()) out.put(f.getAbsolutePath(), f);
+        }
+    }
+
+    private void collectTargetedBySuffixes(File dir, String[] suffixes, int maxDepth, LinkedHashMap<String, File> out, int limit) {
+        if (dir == null || maxDepth < 0 || out.size() >= limit) return;
+        File[] children;
+        try { children = dir.listFiles(); } catch (Exception e) { return; }
+        if (children == null) return;
+        for (File f : children) {
+            if (out.size() >= limit) return;
+            if (f == null) continue;
+            if (f.isDirectory()) {
+                if (maxDepth > 0) collectTargetedBySuffixes(f, suffixes, maxDepth - 1, out, limit);
+                continue;
+            }
+            String name = f.getName().toLowerCase(Locale.ROOT);
+            for (String suffix : suffixes) {
+                if (name.endsWith(suffix.toLowerCase(Locale.ROOT))) {
+                    out.put(f.getAbsolutePath(), f);
+                    break;
+                }
+            }
+        }
+    }
+
+    private void collectAllFilesBounded(File dir, int maxDepth, LinkedHashMap<String, File> out, int limit) {
+        if (dir == null || maxDepth < 0 || out.size() >= limit) return;
+        File[] children;
+        try { children = dir.listFiles(); } catch (Exception e) { return; }
+        if (children == null) return;
+        for (File f : children) {
+            if (out.size() >= limit) return;
+            if (f == null) continue;
+            if (f.isDirectory()) {
+                if (maxDepth > 0) collectAllFilesBounded(f, maxDepth - 1, out, limit);
+            } else if (f.exists()) out.put(f.getAbsolutePath(), f);
+        }
+    }
