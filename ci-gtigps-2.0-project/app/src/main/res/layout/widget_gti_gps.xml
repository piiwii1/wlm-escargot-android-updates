<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GTI GPS"
        android:textColor="#F1F1F1"
        android:textStyle="bold"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/widget_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:text="GOOGLE MAPS"
        android:textColor="#D71920"
        android:textStyle="bold"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_title"
        android:layout_marginTop="12dp"
        android:text="La vraie application Google Maps s’affiche dans cette zone."
        android:textColor="#D5D5D5"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/widget_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:text="Pas de carte GTI, pas de GPS maison.\nCe cadre lance Google Maps lui-même en fenêtre redimensionnée."
        android:textColor="#F1F1F1"
        android:textSize="16sp" />

    <Button
        android:id="@+id/widget_open_maps"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/widget_settings"
        android:layout_marginEnd="6dp"
        android:text="GOOGLE MAPS"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/button_bg" />

    <Button
        android:id="@+id/widget_settings"
        android:layout_width="140dp"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:text="RÉGLAGES"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/button_bg" />
</RelativeLayout>
