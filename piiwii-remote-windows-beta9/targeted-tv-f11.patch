+struct PiiWiiTvWindowSearch {
+    HWND hwnd = nullptr;
+};
+
+static BOOL CALLBACK findPiiWiiTvWindowProc(HWND hwnd, LPARAM param) {
+    auto* search = reinterpret_cast<PiiWiiTvWindowSearch*>(param);
+    if (!search || !IsWindowVisible(hwnd)) return TRUE;
+    const int length = GetWindowTextLengthW(hwnd);
+    if (length <= 0 || length > 2048) return TRUE;
+    std::wstring title(static_cast<size_t>(length) + 1, L'\0');
+    const int copied = GetWindowTextW(hwnd, title.data(), length + 1);
+    if (copied <= 0) return TRUE;
+    title.resize(static_cast<size_t>(copied));
+    if (title.find(L"PiiWii TV") == std::wstring::npos) return TRUE;
+    search->hwnd = hwnd;
+    return FALSE;
+}
+
+static HWND findPiiWiiTvBrowserWindow() {
+    PiiWiiTvWindowSearch search{};
+    EnumWindows(findPiiWiiTvWindowProc, reinterpret_cast<LPARAM>(&search));
+    return search.hwnd;
+}
+
+static bool sendPiiWiiTvBrowserF11() {
+    HWND target = nullptr;
+    // Au démarrage de TV / Direct, le titre de l'onglet peut mettre un court instant à apparaître.
+    for (int attempt = 0; attempt < 20 && !target; ++attempt) {
+        target = findPiiWiiTvBrowserWindow();
+        if (!target) Sleep(75);
+    }
+    if (!target || !IsWindow(target)) return false;
+
+    const HWND previous = GetForegroundWindow();
+    const DWORD currentThread = GetCurrentThreadId();
+    const DWORD targetThread = GetWindowThreadProcessId(target, nullptr);
+    const DWORD previousThread = previous ? GetWindowThreadProcessId(previous, nullptr) : 0;
+    bool attachedTarget = false;
+    bool attachedPrevious = false;
+
+    if (targetThread && targetThread != currentThread) {
+        attachedTarget = AttachThreadInput(currentThread, targetThread, TRUE) != FALSE;
+    }
+    if (previousThread && previousThread != currentThread && previousThread != targetThread) {
+        attachedPrevious = AttachThreadInput(currentThread, previousThread, TRUE) != FALSE;
+    }
+
+    if (IsIconic(target)) ShowWindow(target, SW_RESTORE);
+    BringWindowToTop(target);
+    SetForegroundWindow(target);
+    SetActiveWindow(target);
+    SetFocus(target);
+    Sleep(45);
+    const bool sent = sendVirtualKey(VK_F11);
+    Sleep(90);
+
+    // Remet immédiatement l'utilisateur sur la fenêtre qu'il utilisait avant la commande.
+    if (previous && previous != target && IsWindow(previous)) {
+        BringWindowToTop(previous);
+        SetForegroundWindow(previous);
+    }
+
+    if (attachedPrevious) AttachThreadInput(currentThread, previousThread, FALSE);
+    if (attachedTarget) AttachThreadInput(currentThread, targetThread, FALSE);
+    return sent;
+}
