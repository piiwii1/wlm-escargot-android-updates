+    private void loadPreferences() {
+        flashMode = prefs.getInt("flash", ImageCapture.FLASH_MODE_AUTO);
+        timerSeconds = prefs.getInt("timer", 0);
+        gridEnabled = prefs.getBoolean("grid", false);
+        qualityMode = Math.max(QUALITY_OEM_AUTO, Math.min(QUALITY_MAX_MP, prefs.getInt("quality", QUALITY_OEM_AUTO)));
+        photoMode = prefs.getBoolean("photoMode", true);
+        signDate = prefs.getBoolean("signDate", false);
+        signTime = prefs.getBoolean("signTime", false);
+        signLocation = prefs.getBoolean("signLocation", false);
+        signLogo = prefs.getBoolean("signLogo", false);
+        gridOverlay.setVisibility(gridEnabled ? View.VISIBLE : View.GONE);
+    }
+
+    private void savePreferences() {
+        if (prefs == null) return;
+        prefs.edit()
+                .putInt("flash", flashMode)
+                .putInt("timer", timerSeconds)
+                .putBoolean("grid", gridEnabled)
+                .putInt("quality", qualityMode)
+                .putBoolean("photoMode", photoMode)
+                .putBoolean("signDate", signDate)
+                .putBoolean("signTime", signTime)
+                .putBoolean("signLocation", signLocation)
+                .putBoolean("signLogo", signLogo)
+                .apply();
+    }
+
+    private void prepareOutputRotation() {
+        if (previewView.getDisplay() == null) return;
+        int rotation = previewView.getDisplay().getRotation();
+        if (imageCapture != null) imageCapture.setTargetRotation(rotation);
+        if (videoCapture != null) videoCapture.setTargetRotation(rotation);
+    }
+
+    private void captureFeedback() {
+        try { captureButton.performHapticFeedback(HapticFeedbackConstants.CONFIRM); } catch (Exception ignored) { }
+        if (shutterFlash == null) return;
+        shutterFlash.setVisibility(View.VISIBLE);
+        shutterFlash.setAlpha(0.22f);
+        shutterFlash.animate().alpha(0f).setDuration(110).withEndAction(() -> shutterFlash.setVisibility(View.GONE)).start();
+    }
+
+    @Override
+    public boolean onKeyDown(int keyCode, KeyEvent event) {
+        if (keyCode == KeyEvent.KEYCODE_VOLUME_UP || keyCode == KeyEvent.KEYCODE_VOLUME_DOWN || keyCode == KeyEvent.KEYCODE_CAMERA) {
+            if (event.getRepeatCount() == 0 && captureButton != null && captureButton.isEnabled()) {
+                if (photoMode) triggerPhotoWithTimer(); else toggleVideoRecording();
+            }
+            return true;
+        }
+        return super.onKeyDown(keyCode, event);
+    }
