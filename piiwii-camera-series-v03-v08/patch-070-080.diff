+    private void showCameraDiagnostics() {
+        StringBuilder d = new StringBuilder();
+        d.append(Build.MANUFACTURER).append(" ").append(Build.MODEL).append("\n");
+        d.append("Android ").append(Build.VERSION.RELEASE).append(" · API ").append(Build.VERSION.SDK_INT).append("\n\n");
+        d.append("Caméra : ").append(usingFrontCamera ? "avant" : "arrière").append("\n");
+        d.append("Mode : ").append(photoMode ? qualityModeName() : "VIDÉO " + videoQualityName()).append("\n");
+        d.append(String.format(Locale.getDefault(), "Zoom exposé : %.2f× → %.2f×\n", minZoom, maxZoom));
+        if (maxExposure > minExposure) d.append(String.format(Locale.getDefault(), "EV : %+.1f → %+.1f\n", minExposure * exposureStep, maxExposure * exposureStep));
+        if (camera != null) {
+            CameraInfo info = camera.getCameraInfo();
+            d.append("Flash : ").append(info.hasFlashUnit() ? "oui" : "non").append("\n");
+            d.append("Low Light Boost : ").append(info.isLowLightBoostSupported() ? "oui" : "non").append("\n");
+            d.append("Multi-caméra logique : ").append(info.isLogicalMultiCameraSupported() ? "oui" : "non").append("\n");
+            try { d.append("Caméras physiques exposées : ").append(info.getPhysicalCameraInfos().size()).append("\n"); } catch (Exception ignored) { }
+            try {
+                int maxTorch = info.getMaxTorchStrengthLevel();
+                if (maxTorch > 0) d.append("Niveaux torche : ").append(maxTorch).append("\n");
+            } catch (Exception ignored) { }
+        }
+        d.append("Ultra HDR : ").append(supportsUltraHdr(resolvePhotoSelector()) ? "oui" : "non").append("\n");
+        if (extensionsManager != null) {
+            try {
+                CameraSelector base = baseSelector();
+                d.append("OEM Auto : ").append(extensionsManager.isExtensionAvailable(base, ExtensionMode.AUTO) ? "oui" : "non").append("\n");
+                d.append("OEM HDR : ").append(extensionsManager.isExtensionAvailable(base, ExtensionMode.HDR) ? "oui" : "non").append("\n");
+                d.append("OEM Nuit : ").append(extensionsManager.isExtensionAvailable(base, ExtensionMode.NIGHT) ? "oui" : "non").append("\n");
+            } catch (Exception ignored) { }
+        }
+        d.append("\nPiiWii Camera 0.8.0 · CameraX 1.6.2");
+        new AlertDialog.Builder(this)
+                .setTitle("Diagnostic caméra")
+                .setMessage(d.toString())
+                .setPositiveButton("Fermer", null)
+                .show();
+    }
