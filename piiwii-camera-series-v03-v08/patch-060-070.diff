+    private void rememberLastMedia(Uri uri, String type) {
+        lastMediaUri = uri;
+        lastMediaType = type;
+        prefs.edit().putString("lastMediaUri", uri.toString()).putString("lastMediaType", type).apply();
+        if (type.startsWith("image")) loadThumb(uri);
+        else {
+            lastPhotoThumb.setImageDrawable(null);
+            lastPhotoThumb.setContentDescription("Dernière vidéo");
+        }
+    }
+
+    private void restoreLastMediaPreview() {
+        if (prefs == null || lastPhotoThumb == null) return;
+        String uriText = prefs.getString("lastMediaUri", null);
+        lastMediaType = prefs.getString("lastMediaType", "image/*");
+        if (uriText == null || uriText.isEmpty()) return;
+        try {
+            lastMediaUri = Uri.parse(uriText);
+            if (lastMediaType.startsWith("image")) loadThumb(lastMediaUri);
+            else lastPhotoThumb.setContentDescription("Dernière vidéo");
+        } catch (Exception ignored) { }
+    }
+
+    private void loadThumb(Uri uri) {
+        ioExecutor.execute(() -> {
+            try {
+                BitmapFactory.Options bounds = new BitmapFactory.Options();
+                bounds.inJustDecodeBounds = true;
+                try (InputStream in = getContentResolver().openInputStream(uri)) { if (in != null) BitmapFactory.decodeStream(in, null, bounds); }
+                int sample = 1;
+                int biggest = Math.max(bounds.outWidth, bounds.outHeight);
+                while (biggest / sample > 320) sample *= 2;
+                BitmapFactory.Options opts = new BitmapFactory.Options();
+                opts.inSampleSize = Math.max(1, sample);
+                final Bitmap thumb;
+                try (InputStream in = getContentResolver().openInputStream(uri)) { thumb = in == null ? null : BitmapFactory.decodeStream(in, null, opts); }
+                if (thumb != null) runOnUiThread(() -> lastPhotoThumb.setImageBitmap(thumb));
+            } catch (Exception ignored) { }
+        });
+    }
+
+    private void openLastMedia() {
+        if (lastMediaUri == null) {
+            Toast.makeText(this, "Aucune capture récente", Toast.LENGTH_SHORT).show();
+            return;
+        }
+        try {
+            Intent intent = new Intent(Intent.ACTION_VIEW);
+            intent.setDataAndType(lastMediaUri, lastMediaType);
+            intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
+            startActivity(intent);
+        } catch (Exception e) {
+            Toast.makeText(this, "Impossible d'ouvrir la dernière capture", Toast.LENGTH_SHORT).show();
+        }
+    }
+
