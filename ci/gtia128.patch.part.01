+    private static long locationAgeMs(Location location) {
+        if (location == null) return Long.MAX_VALUE;
+        if (Build.VERSION.SDK_INT >= 17 && location.getElapsedRealtimeNanos() > 0L) {
+            long delta = SystemClock.elapsedRealtimeNanos() - location.getElapsedRealtimeNanos();
+            if (delta >= 0L) return delta / 1000000L;
+        }
+        long t = location.getTime();
+        if (t <= 0L) return Long.MAX_VALUE;
+        return Math.abs(System.currentTimeMillis() - t);
+    }
+
+    private static long normalizedFixTime(Location location, long now) {
+        long age = locationAgeMs(location);
