@@ -207,13 +209,34 @@
     }
 
     public static double displayAltitude(Context c) {
-        if (isGpsFresh(c)) return filtered(c);
-        if (isBaroFresh(c)) return baroAltitude(c);
+        boolean gps = isGpsFresh(c);
+        boolean baro = isBaroFresh(c);
+        if (gps && baro) {
+            // Hybrid altitude: GPS keeps absolute altitude, barometer removes short-term jitter.
+            // The worse the GPS vertical precision, the more the barometer stabilises the display.
+            double g = filtered(c);
+            double b = baroAltitude(c);
+            float acc = acceptedVAcc(c);
+            if (Float.isNaN(acc) || acc <= 0f) {
+                float h = acceptedHAcc(c);
+                acc = (!Float.isNaN(h) && h > 0f) ? h * 1.45f : 45f;
+            }
+            double gpsWeight;
+            if (acc <= 6f) gpsWeight = 0.78;
+            else if (acc <= 12f) gpsWeight = 0.64;
+            else if (acc <= 25f) gpsWeight = 0.48;
+            else if (acc <= 60f) gpsWeight = 0.32;
+            else gpsWeight = 0.20;
+            return b + gpsWeight * (g - b);
+        }
+        if (gps) return filtered(c);
+        if (baro) return baroAltitude(c);
         return Double.NaN;
     }
 
     public static String displaySource(Context c) {
-        if (isGpsFresh(c)) return baroCalibrated(c) ? "GPS + BARO" : "GPS";
+        if (isGpsFresh(c) && isBaroFresh(c)) return "GPS + BARO";
+        if (isGpsFresh(c)) return "GPS";
         if (isBaroFresh(c)) return "BARO";
         return "—";
     }
