     }
 
     Result push(double raw, float horizontalAccuracy, float verticalAccuracy, long timeMs) {
         if (Double.isNaN(raw) || Double.isInfinite(raw)) return new Result(false, filtered, "altitude invalide");
-        if (!Float.isNaN(horizontalAccuracy) && horizontalAccuracy > 200f) return new Result(false, filtered, "précision horizontale > 200 m");
-        if (!Float.isNaN(verticalAccuracy) && verticalAccuracy > 180f) return new Result(false, filtered, "précision verticale > 180 m");
+        if (!Float.isNaN(horizontalAccuracy) && horizontalAccuracy > 320f) return new Result(false, filtered, "précision horizontale > 320 m");
+        if (!Float.isNaN(verticalAccuracy) && verticalAccuracy > 280f) return new Result(false, filtered, "précision verticale > 280 m");
+
+        float sigma = estimateSigma(horizontalAccuracy, verticalAccuracy);
 
         if (!Double.isNaN(lastRaw) && lastTime > 0L && timeMs > lastTime) {
             double dt = Math.max(0.25, (timeMs - lastTime) / 1000.0);
-            double allowed = 30.0 + 18.0 * dt;
+            // Poor fixes are allowed to move farther; good fixes are held to a tighter physical envelope.
+            double allowed = Math.max(28.0, Math.min(150.0, sigma * 1.7)) + 16.0 * dt;
             if (Math.abs(raw - lastRaw) > allowed) {
                 lastRaw = raw;
                 lastTime = timeMs;
@@ -47,20 +57,48 @@
         lastRaw = raw;
         lastTime = timeMs;
 
-        window.addLast(raw);
-        while (window.size() > 5) window.removeFirst();
-        List<Double> sorted = new ArrayList<>(window);
-        Collections.sort(sorted);
-        double median = sorted.get(sorted.size() / 2);
+        window.addLast(new Sample(raw, sigma));
+        while (window.size() > 9) window.removeFirst();
+
+        List<Double> values = new ArrayList<>();
+        for (Sample sample : window) values.add(sample.altitude);
+        Collections.sort(values);
+        double median = values.get(values.size() / 2);
+
+        // Weighted robust centre: vertical accuracy when available, otherwise conservative H-accuracy proxy.
+        double sum = 0.0;
+        double weightSum = 0.0;
+        for (Sample sample : window) {
+            double residual = Math.abs(sample.altitude - median);
+            double gate = Math.max(12.0, Math.min(95.0, 2.2 * sample.sigma + 8.0));
+            if (residual > gate) continue;
+            double sigmaM = Math.max(3.0, sample.sigma);
+            double weight = 1.0 / (sigmaM * sigmaM);
+            sum += sample.altitude * weight;
+            weightSum += weight;
+        }
+        double centre = weightSum > 0.0 ? sum / weightSum : median;
 
         if (Double.isNaN(filtered)) {
-            filtered = median;
+            filtered = centre;
         } else {
-            double delta = Math.abs(median - filtered);
-            double alpha = delta > 15.0 ? 0.48 : (delta > 5.0 ? 0.30 : 0.16);
-            if (!Float.isNaN(horizontalAccuracy) && horizontalAccuracy > 35f) alpha *= 0.65;
-            filtered += alpha * (median - filtered);
+            double delta = Math.abs(centre - filtered);
+            double alpha;
+            if (sigma <= 6f) alpha = 0.58;
+            else if (sigma <= 12f) alpha = 0.46;
+            else if (sigma <= 25f) alpha = 0.34;
+            else if (sigma <= 60f) alpha = 0.22;
+            else alpha = 0.12;
+            if (delta > 20.0) alpha = Math.max(alpha, 0.42);
+            else if (delta > 8.0) alpha = Math.max(alpha, 0.30);
+            filtered += alpha * (centre - filtered);
         }
         return new Result(true, filtered, "OK");
     }
+
+    private static float estimateSigma(float hAcc, float vAcc) {
+        if (!Float.isNaN(vAcc) && vAcc > 0f) return Math.max(3f, vAcc);
+        if (!Float.isNaN(hAcc) && hAcc > 0f) return Math.max(5f, hAcc * 1.45f);
+        return 45f;
+    }
 }
