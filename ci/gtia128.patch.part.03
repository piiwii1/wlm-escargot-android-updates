+            if (used >= 5) return 3;
+            if (used >= 3) return 2;
+            if (used >= 1) return 1;
+            // Satellites visible but no fix yet: show acquisition rather than a dead signal.
+            if (visible >= 8 || (!Float.isNaN(cn0) && cn0 >= 28f)) return 2;
+            if (visible > 0 || (!Float.isNaN(cn0) && cn0 >= 18f)) return 1;
+        }
+
+        // Fallback for units exposing only fused/network location and no GnssStatus callback.
+        if (!AltitudeState.isRawGpsFresh(context)) return 0;
+        float accuracy = bestVisibleAccuracy(context);
+        if (Float.isNaN(accuracy)) return 1;
         if (accuracy <= 8f) return 4;
         if (accuracy <= 20f) return 3;
-        if (accuracy <= 45f) return 2;
