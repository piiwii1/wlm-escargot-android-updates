<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GTI GPS"
        android:textColor="#F1F1F1"
        android:textStyle="bold"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/widget_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:text="CARTE"
        android:textColor="#D71920"
        android:textStyle="bold"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_title"
        android:layout_marginTop="12dp"
        android:text="Carte interactive externe prête"
        android:textColor="#A7A7A7"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/widget_position"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_status"
        android:layout_marginTop="8dp"
        android:text="GPS : en attente"
        android:textColor="#F1F1F1"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/widget_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:text="La vraie carte MapLibre s’affiche dans ce cadre via le panneau GPS externe."
        android:textColor="#D0D0D0"
        android:textSize="15sp" />

    <Button
        android:id="@+id/widget_open_map"
        android:layout_width="170dp"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:text="AFFICHER CARTE"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/button_bg" />

    <Button
        android:id="@+id/widget_settings"
        android:layout_width="150dp"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:text="RÉGLAGES"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/button_bg" />
</RelativeLayout>
