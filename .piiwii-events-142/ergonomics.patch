+    private fun showEventFilterDialog() {
+        val filters = arrayOf("Tous", "Actifs", "Désactivés", "Annuels", "Ponctuels", "Calculés automatiquement")
+        AlertDialog.Builder(this)
+            .setTitle("Filtrer les événements")
+            .setSingleChoiceItems(filters, filters.indexOf(eventFilter).coerceAtLeast(0)) { dialog, which ->
+                eventFilter = filters[which]
+                dialog.dismiss()
+                showTab(1)
+            }
+            .setNegativeButton("Annuler", null)
+            .show()
+    }
+
+    private fun showEventActions(event: EventDefinition) {
+        val labels = mutableListOf("Changer l’image", "Tester dans le widget")
+        if (event.id != DefaultEvents.NEUTRAL_ID && event.id != DefaultEvents.FC_SION_ID) {
+            labels += "Dupliquer"
+            labels += "Supprimer"
+        }
+        AlertDialog.Builder(this)
+            .setTitle(event.name)
+            .setItems(labels.toTypedArray()) { _, which ->
+                when (labels[which]) {
+                    "Changer l’image" -> chooseImageFor(event.id)
+                    "Tester dans le widget" -> { WidgetRenderer.setTestEvent(this, event.id); toast("${event.name} affiché dans le widget") }
+                    "Dupliquer" -> duplicate(event)
+                    "Supprimer" -> confirmDelete(event)
+                }
+            }
+            .setNegativeButton("Fermer", null)
+            .show()
+    }
+
+    private fun showWidgetMenu() {
+        val items = arrayOf("Ajouter le widget", "Aide écran verrouillé")
+        AlertDialog.Builder(this).setTitle("Widget").setItems(items) { _, which ->
+            if (which == 0) requestAddWidget() else showLockScreenHelp()
+        }.setNegativeButton("Fermer", null).show()
+    }
+
+    private fun showTimeSettingsMenu() {
+        val items = mutableListOf("Fuseau horaire")
+        if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.S && !getSystemService(AlarmManager::class.java).canScheduleExactAlarms()) items += "Autoriser les alarmes exactes"
+        AlertDialog.Builder(this).setTitle("Heure et déclenchement").setItems(items.toTypedArray()) { _, which ->
+            if (items[which] == "Fuseau horaire") showTimeZoneDialog() else requestExactAlarmAccess()
+        }.setNegativeButton("Fermer", null).show()
+    }
+
+    private fun showBackupMenu() {
+        AlertDialog.Builder(this).setTitle("Sauvegarde").setItems(arrayOf("Exporter", "Importer")) { _, which ->
+            if (which == 0) exportBackup() else importBackup()
+        }.setNegativeButton("Fermer", null).show()
+    }
