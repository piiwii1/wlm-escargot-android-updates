+            texts.addView(UiFactory.muted(this@MainActivity, subtitle))
+            row.addView(texts, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
+            row.addView(UiFactory.body(this@MainActivity, "›", 28f).apply { gravity = Gravity.CENTER })
