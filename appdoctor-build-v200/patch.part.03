+    private static final class DeepSnapshot {
+        String identity = "";
+        String batterystats = "";
+        String procstats = "";
+        String services = "";
+        String jobs = "";
+        String deviceIdle = "";
+        String crashes = "";
+        String anrs = "";
+        String error = "";
+        String render() {
+            StringBuilder s = new StringBuilder();
+            s.append("DIAGNOSTIC SYSTÈME SHIZUKU / ADB\n");
+            s.append("----------------------------------------\n");
+            s.append("Identité : ").append(identity.replace('\n', ' ').trim()).append('\n');
+            s.append("Batterystats : ").append(batterystats.length()).append(" caractères analysés\n");
+            s.append("Procstats : ").append(procstats.length()).append(" caractères analysés\n");
+            s.append("Services : ").append(services.length()).append(" caractères analysés\n");
+            s.append("JobScheduler : ").append(jobs.length()).append(" caractères analysés\n");
+            s.append("Crash DropBox : ").append(crashes.length()).append(" caractères analysés\n");
+            s.append("ANR DropBox : ").append(anrs.length()).append(" caractères analysés\n");
+            if (!error.isEmpty()) s.append("⚠ Erreur partielle : ").append(error).append('\n');
+            s.append('\n');
+            return s.toString();
+        }
+    }
