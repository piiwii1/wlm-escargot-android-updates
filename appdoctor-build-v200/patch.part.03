dans DropBox : " + r.anrMentions + " occurrence(s)");
+        if (containsIgnoreCase(appops, "RUN_ANY_IN_BACKGROUND: ignore") || containsIgnoreCase(appops, "RUN_IN_BACKGROUND: ignore")) {
+            r.addBattery(4, "AppOps limite l'exécution en arrière-plan (état ignore détecté)");
+        }
+        if (containsIgnoreCase(appops, "WAKE_LOCK") && !containsIgnoreCase(appops, "WAKE_LOCK: deny")) {
+            r.deepWakeLockOp = true;
+        }
+    }
+
+    private String shellExec(String command) throws RemoteException {
+        IAppDoctorShell shell = shellService;
+        if (shell == null) throw new RemoteException("Service Shizuku non connecté");
+        String out = shell.exec(command);
+        return out == null ? "" : out;
+    }
+
+    private void status(String text, int progress) {
+        runOnUiThread(() -> {
+            statusView.setText(text);
+            progressBar.setProgress(Math.max(0, Math.min(99, progress)));
+        });
+    }
+
+    private int occurrences(String haystack, String needle) {
+        if (empty(haystack) || empty(needle)) return 0;
+        String h = haystack.toLowerCase(Locale.ROOT), n = needle.toLowerCase(Locale.ROOT);
+        int count = 0, pos = 0;
+        while ((pos = h.indexOf(n, pos)) >= 0) { count++; pos += n.length(); if (count >= 99) break; }
+        return count;
+    }
+
+    private boolean containsIgnoreCase(String a, String b) {
+        return a != null && b != null && a.toLowerCase(Locale.ROOT).contains(b.toLowerCase(Locale.ROOT));
+    }
+
+    private String compactAppOps(String text) {
+        if (empty(text)) return "aucune donnée";
+        StringBuilder out = new StringBuilder();
+        String[] watched = {"WAKE_LOCK", "RUN_IN_BACKGROUND", "RUN_ANY_IN_BACKGROUND", "FINE_LOCATION", "COARSE_LOCATION", "CAMERA", "RECORD_AUDIO", "SYSTEM_ALERT_WINDOW"};
+        for (String line : text.split("\\n")) {
+            for (String w : watched) if (line.contains(w)) { if (out.length() > 0) out.append(" | "); out.append(line.trim()); break; }
+            if (out.length() > 1200) break;
+        }
+        return out.length() == 0 ? "aucun AppOp sensible retenu" : out.toString();
+    }
