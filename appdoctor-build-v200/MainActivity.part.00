import rikka.shizuku.Shizuku;

public class MainActivity extends Activity {
    private static final int SAVE_REPORT_REQUEST = 901;
    private static final long DAY = 24L * 60L * 60L * 1000L;
    private static final String VERSION = "2.0.0";
    private static final int SHIZUKU_PERMISSION_REQUEST = 902;
    private final ExecutorService executor = Executors.newSingleThreadExecutor();

    private Button analyzeButton;
    private Button copyButton;
    private Button saveButton;
    private Button shareButton;
    private Button usageButton;
    private Button shizukuButton;
    private Button deepAnalyzeButton;
    private TextView accessStatusView;
    private volatile IAppDoctorShell shellService;
    private volatile boolean pendingDeepAnalysis;
    private TextView statusView;
    private TextView reportView;
    private ProgressBar progressBar;
    private String lastReport = "";

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        Shizuku.addRequestPermissionResultListener(shizukuPermissionListener);
        Shizuku.addBinderReceivedListener(shizukuBinderReceivedListener);
        Shizuku.addBinderDeadListener(shizukuBinderDeadListener);
        buildUi();
        updateAccessStatus();
    }

    @Override
    protected void onResume() {
        super.onResume();
        if (usageButton != null) updateAccessStatus();
    }

    @Override
    protected void onDestroy() {
        executor.shutdownNow();
        Shizuku.removeRequestPermissionResultListener(shizukuPermissionListener);
        Shizuku.removeBinderReceivedListener(shizukuBinderReceivedListener);
        Shizuku.removeBinderDeadListener(shizukuBinderDeadListener);
        try { if (userServiceArgs != null) Shizuku.unbindUserService(userServiceArgs, userServiceConnection, false); } catch (Throwable ignored) {}
        super.onDestroy();
    }

    private void buildUi() {
        ScrollView root = new ScrollView(this);
        root.setFillViewport(true);
        root.setBackgroundColor(Color.rgb(243, 244, 246));

        LinearLayout content = new LinearLayout(this);
        content.setOrientation(LinearLayout.VERTICAL);
        content.setPadding(dp(18), dp(22), dp(18), dp(30));
        root.addView(content, new ScrollView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));

        TextView title = new TextView(this);
        title.setText("AppDoctor");
        title.setTextSize(30);
        title.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        title.setTextColor(Color.rgb(17, 24, 39));
        content.addView(title);

        TextView subtitle = new TextView(this);
        subtitle.setText("Diagnostic Android local • v" + VERSION);
        subtitle.setTextSize(15);
        subtitle.setTextColor(Color.rgb(75, 85, 99));
        subtitle.setPadding(0, dp(3), 0, dp(16));
        content.addView(subtitle);

        TextView privacy = cardText("Deux niveaux : analyse rapide locale + diagnostic approfondi via Shizuku. Le mode approfondi demande explicitement les accès utiles et interroge Android avec l'identité ADB/shell. AppDoctor ne possède toujours aucune permission Internet.");
        content.addView(privacy);

        analyzeButton = makeButton("ANALYSE RAPIDE", false);
        analyzeButton.setOnClickListener(v -> startAnalysis(false));
        content.addView(analyzeButton, buttonParams());

        deepAnalyzeButton = makeButton("DIAGNOSTIC APPROFONDI", true);
        deepAnalyzeButton.setOnClickListener(v -> prepareDeepAnalysis());
        content.addView(deepAnalyzeButton, buttonParams());

        accessStatusView = cardText("Vérification des accès…");
        content.addView(accessStatusView);

        usageButton = makeButton("AUTORISER LES STATISTIQUES", false);
        usageButton.setOnClickListener(v -> {
            try {
                Intent intent = new Intent(Settings.ACTION_USAGE_ACCESS_SETTINGS);
                intent.setData(Uri.parse("package:" + getPackageName()));
                startActivity(intent);
            } catch (Exception e) {
                startActivity(new Intent(Settings.ACTION_USAGE_ACCESS_SETTINGS));
            }
        });
        content.addView(usageButton, buttonParams());

        shizukuButton = makeButton("AUTORISER SHIZUKU", false);
        shizukuButton.setOnClickListener(v -> requestOrOpenShizuku());
        content.addView(shizukuButton, buttonParams());

        progressBar = new ProgressBar(this, null, android.R.attr.progressBarStyleHorizontal);
        progressBar.setIndeterminate(false);
        progressBar.setMax(100);
        progressBar.setProgress(0);
        progressBar.setVisibility(View.GONE);
        LinearLayout.LayoutParams progressParams = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(6));
        progressParams.setMargins(0, dp(10), 0, dp(4));
        content.addView(progressBar, progressParams);

        statusView = new TextView(this);
        statusView.setText("Prêt à analyser.");
        statusView.setTextSize(14);
        statusView.setTextColor(Color.rgb(55, 65, 81));
        statusView.setPadding(dp(2), dp(8), dp(2), dp(8));
        content.addView(statusView);

        LinearLayout actions = new LinearLayout(this);
        actions.setOrientation(LinearLayout.HORIZONTAL);
        copyButton = makeButton("COPIER", false);
        saveButton = makeButton("ENREGISTRER", false);
        copyButton.setEnabled(false);
        saveButton.setEnabled(false);
        copyButton.setOnClickListener(v -> copyReport());
        saveButton.setOnClickListener(v -> saveReport());
        LinearLayout.LayoutParams half = new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f);
        half.setMargins(0, dp(7), dp(5), dp(4));
        actions.addView(copyButton, half);
        LinearLayout.LayoutParams half2 = new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f);
        half2.setMargins(dp(5), dp(7), 0, dp(4));
        actions.addView(saveButton, half2);
        content.addView(actions);

        shareButton = makeButton("PARTAGER LE RAPPORT", false);
        shareButton.setEnabled(false);
        shareButton.setOnClickListener(v -> shareReport());
        content.addView(shareButton, buttonParams());

        reportView = new TextView(this);
        reportView.setText("Le rapport apparaîtra ici après l'analyse.");
        reportView.setTextSize(12.5f);
        reportView.setTextColor(Color.rgb(17, 24, 39));
        reportView.setTextIsSelectable(true);
        reportView.setTypeface(Typeface.MONOSPACE);
        reportView.setPadding(dp(14), dp(14), dp(14), dp(14));
        reportView.setBackgroundColor(Color.WHITE);
        content.addView(reportView, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));

        setContentView(root);
    }

    private TextView cardText(String text) {
        TextView tv = new TextView(this);
        tv.setText(text);
        tv.setTextSize(14);
        tv.setLineSpacing(0f, 1.12f);
        tv.setTextColor(Color.rgb(31, 41, 55));
        tv.setBackgroundColor(Color.WHITE);
        tv.setPadding(dp(14), dp(13), dp(14), dp(13));
        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
        lp.setMargins(0, 0, 0, dp(12));
        tv.setLayoutParams(lp);
        return tv;
    }

    private Button makeButton(String text, boolean primary) {
        Button button = new Button(this);
        button.setText(text);
        button.setTextSize(14);
        button.setAllCaps(false);
        button.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        button.setMinHeight(dp(50));
        if (primary) {
            button.setTextColor(Color.WHITE);
            button.setBackgroundTintList(android.content.res.ColorStateList.valueOf(Color.rgb(37, 99, 235)));
        } else {
            button.setTextColor(Color.rgb(17, 24, 39));
            button.setBackgroundTintList(android.content.res.ColorStateList.valueOf(Color.WHITE));
        }
        return button;
    }

    private LinearLayout.LayoutParams buttonParams() {
        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
        lp.setMargins(0, dp(5), 0, dp(5));
        return lp;
    }

    private final Shizuku.OnRequestPermissionResultListener shizukuPermissionListener = (requestCode, grantResult) -> {
        if (requestCode != SHIZUKU_PERMISSION_REQUEST) return;
        updateAccessStatus();
        if (grantResult == PackageManager.PERMISSION_GRANTED && pendingDeepAnalysis) bindShellAndRunDeep();
    };

    private final Shizuku.OnBinderReceivedListener shizukuBinderReceivedListener = () -> {
        updateAccessStatus();
        if (pendingDeepAnalysis && hasShizukuPermission()) bindShellAndRunDeep();
    };

    private final Shizuku.OnBinderDeadListener shizukuBinderDeadListener = () -> {
        shellService = null;
        updateAccessStatus();
    };

    private Shizuku.UserServiceArgs userServiceArgs;
    private final ServiceConnection userServiceConnection = new ServiceConnection() {
        @Override public void onServiceConnected(ComponentName name, IBinder service) {
            shellService = IAppDoctorShell.Stub.asInterface(service);
            updateAccessStatus();
            if (pendingDeepAnalysis) startAnalysis(true);
        }
        @Override public void onServiceDisconnected(ComponentName name) {
            shellService = null;
            updateAccessStatus();
        }
    };

    private void updateAccessStatus() {
        if (usageButton == null) return;
        boolean usage = hasUsageAccess();
        boolean binder = isShizukuRunning();
        boolean shizuku = binder && hasShizukuPermission();
        usageButton.se