@@ -0,0 +1,44 @@
+package ch.piiwii.notificationwidget;
+import java.util.Locale;
+
+/** Generic Android media-session classification, keeping the saved category id 'spotify'. */
+final class MediaSourcePolicy {
+  private MediaSourcePolicy(){}
+  static boolean known(String pkg){
+    if(pkg==null)return false;
+    String p=pkg.toLowerCase(Locale.ROOT);
+    return p.contains("spotify")||p.contains("youtube.music")||p.contains("deezer")||
+      p.contains("apple.android.music")||p.contains("amazon.mp3")||p.contains("soundcloud")||
+      p.contains("tidal")||p.contains("pandora")||p.contains("qobuz")||
+      p.contains("music")||p.contains("audio")||p.contains("poweramp")||
+      p.contains("vlc")||p.contains("podcast")||p.contains("audiobook")||
+      p.contains("radio")||p.contains("plexamp")||p.contains("foobar2000");
+  }
+  static boolean ignored(String pkg){
+    if(pkg==null||pkg.isEmpty())return true;
+    String p=pkg.toLowerCase(Locale.ROOT);
+    return p.contains("incallui")||p.contains("dialer")||p.contains("telecom")||
+      p.contains("android.phone")||p.equals("android")||p.contains("systemui");
+  }
+  /** A playing media session always wins over a stopped/paused session. */
+  static int score(String pkg,boolean playing){
+    if(ignored(pkg))return -1;
+    if(playing)return known(pkg)?200:100;
+    return known(pkg)?20:-1;
+  }
+  static String label(String pkg){
+    String p=pkg==null?"":pkg.toLowerCase(Locale.ROOT);
+    if(p.contains("spotify"))return "Spotify";
+    if(p.contains("youtube.music"))return "YouTube Music";
+    if(p.contains("deezer"))return "Deezer";
+    if(p.contains("apple.android.music"))return "Apple Music";
+    if(p.contains("amazon.mp3"))return "Amazon Music";
+    if(p.contains("soundcloud"))return "SoundCloud";
+    if(p.contains("tidal"))return "TIDAL";
+    if(p.contains("qobuz"))return "Qobuz";
+    if(p.contains("pandora"))return "Pandora";
+    if(p.contains("vlc"))return "VLC";
+    if(p.contains("poweramp"))return "Poweramp";
+    return "Lecteur multimédia";
+  }
+}
