@@ -0,0 +1,20 @@
+package ch.piiwii.notificationwidget;
+public class MediaSourcePolicyRegression {
+  static int assertions=0;
+  static void check(boolean b,String s){assertions++;if(!b)throw new AssertionError(s);}
+  public static void main(String[] args){
+    check(MediaSourcePolicy.known("com.spotify.music"),"Spotify");
+    check(MediaSourcePolicy.known("com.google.android.apps.youtube.music"),"YouTube Music");
+    check(MediaSourcePolicy.known("deezer.android.app"),"Deezer");
+    check(MediaSourcePolicy.known("org.videolan.vlc"),"VLC");
+    check(MediaSourcePolicy.known("com.apple.android.music"),"Apple Music");
+    check(!MediaSourcePolicy.known("com.whatsapp"),"Message non musical");
+    check(MediaSourcePolicy.ignored("com.android.incallui"),"Pas les appels");
+    check(MediaSourcePolicy.score("com.spotify.music",true)>MediaSourcePolicy.score("org.videolan.vlc",false),"Lecture prioritaire");
+    check(MediaSourcePolicy.score("unknown.audio_player",true)>MediaSourcePolicy.score("com.spotify.music",false),"Lecteur actif préféré");
+    check(MediaSourcePolicy.score("com.android.incallui",true)<0,"Ignorer appels");
+    check("YouTube Music".equals(MediaSourcePolicy.label("com.google.android.apps.youtube.music")),"Libellé source");
+    check("Lecteur multimédia".equals(MediaSourcePolicy.label("com.unknown.package")),"Libellé neutre");
+    System.out.println("PASS "+assertions+" contrôles de source média");
+  }
+}
