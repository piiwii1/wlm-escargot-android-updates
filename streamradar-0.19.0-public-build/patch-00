+                    Text("StreamRadar", style = MaterialTheme.typography.headlineSmall, fontWeight = FontWeight.Black)
+                    Text("Films • Séries • Dernières sorties", color = MaterialTheme.colorScheme.secondary, style = MaterialTheme.typography.bodyMedium, fontWeight = FontWeight.SemiBold)
+                    Spacer(Modifier.height(10.dp))
+                    Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                        AccentStat("Aujourd’hui", todayCount.toString(), MaterialTheme.colorScheme.tertiary)
+                        AccentStat("7 jours", weekCount.toString(), MaterialTheme.colorScheme.primary)
+                    }
+                }
+                IconButton(onClick = onRefresh, enabled = !syncing) {
+                    if (syncing) CircularProgressIndicator(Modifier.size(22.dp), strokeWidth = 2.dp)
+                    else Icon(Icons.Default.Refresh, contentDescription = "Actualiser")
+                }
+            }
+        }
+    }
