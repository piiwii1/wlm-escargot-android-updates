+@Composable
+private fun HomeBrandHeader(releases: List<Release>, syncing: Boolean, onRefresh: () -> Unit) {
+    val today = LocalDate.now()
+    fun parsed(r: Release) = r.releaseDate?.let { runCatching { LocalDate.parse(it) }.getOrNull() }
+    val todayCount = releases.count { parsed(it) == today }
+    val weekCount = releases.count { parsed(it)?.let { d -> !d.isBefore(today) && !d.isAfter(today.plusDays(7)) } == true }
+    Card(
+        modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 14.dp),
+        shape = RoundedCornerShape(28.dp),
+        colors = CardDefaults.cardColors(containerColor = Color(0xFF0D1B29))
+    ) {
+        Box(
+            Modifier.fillMaxWidth().background(
+                Brush.linearGradient(listOf(Color(0xFF102535), Color(0xFF0D1B29), Color(0xFF15152A)))
+            )
+        ) {
+            Row(Modifier.fillMaxWidth().padding(16.dp), verticalAlignment = Alignment.CenterVertically) {
+                Image(
+                    painter = painterResource(ch.piiwii.streamradar.R.drawable.streamradar_brand),
+                    contentDescription = "StreamRadar",
+                    modifier = Modifier.size(82.dp).clip(RoundedCornerShape(20.dp)),
+                    contentScale = ContentScale.Crop
+                )
+                Spacer(Modifier.width(14.dp))
