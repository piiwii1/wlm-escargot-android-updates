+    suspend fun addRecentSearch(value: String) = context.dataStore.edit { prefs ->
+        val clean = value.trim().replace("\u001F", " ").take(120)
+        if (clean.isBlank()) return@edit
+        val current = prefs[Keys.recentSearches]
+            ?.split("\u001F")
+            ?.filter { it.isNotBlank() }
+            ?.toMutableList()
+            ?: mutableListOf()
+        current.removeAll { it.equals(clean, ignoreCase = true) }
+        current.add(0, clean)
+        prefs[Keys.recentSearches] = current.take(10).joinToString("\u001F")
+    }
+
+    suspend fun removeRecentSearch(value: String) = context.dataStore.edit { prefs ->
+        val current = prefs[Keys.recentSearches]
+            ?.split("\u001F")
+            ?.filter { it.isNotBlank() && !it.equals(value, ignoreCase = true) }
+            ?: emptyList()
+        if (current.isEmpty()) prefs.remove(Keys.recentSearches) else prefs[Keys.recentSearches] = current.joinToString("\u001F")
+    }
+
+    suspend fun clearRecentSearches() = context.dataStore.edit { prefs -> prefs.remove(Keys.recentSearches) }
