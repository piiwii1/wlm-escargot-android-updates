+package ch.piiwii.events.service
+
+import android.content.Context
+import ch.piiwii.events.data.DefaultEvents
+import ch.piiwii.events.data.EventRepository
+import ch.piiwii.events.widget.WidgetRenderer
+
+object FcSionMatchState {
+    private const val LIVE_SAFETY_WINDOW_MS = 5L * 60L * 60L * 1000L
+
+    fun activate(context: Context, source: String) {
+        val repo = EventRepository.get(context)
+        val config = repo.load()
+        val event = config.events.firstOrNull { it.id == DefaultEvents.FC_SION_ID } ?: return
+        if (!event.enabled) return
+        val now = System.currentTimeMillis()
+        if (config.settings.fcSionActiveSince <= 0L || config.settings.fcSionActiveUntil <= now) {
+            config.settings.fcSionActiveSince = now
+        }
+        config.settings.fcSionActiveUntil = now + LIVE_SAFETY_WINDOW_MS
+        config.settings.fcSionLastDetectedAt = now
+        config.settings.fcSionLastSignal = "Match FC Sion détecté via $source"
+        repo.save(config)
+        WidgetRenderer.updateAll(context, "fc_sion_${source.lowercase().replace(' ', '_')}_live")
+    }
+
+    fun finish(context: Context, source: String) {
+        val repo = EventRepository.get(context)
+        val config = repo.load()
+        val event = config.events.firstOrNull { it.id == DefaultEvents.FC_SION_ID } ?: return
+        if (!event.enabled) return
+        val now = System.currentTimeMillis()
+        if (config.settings.fcSionActiveSince <= 0L) config.settings.fcSionActiveSince = now
+        config.settings.fcSionActiveUntil = now
+        config.settings.fcSionLastDetectedAt = now
+        config.settings.fcSionLastSignal = "Fin du match FC Sion détectée via $source"
+        repo.save(config)
+        WidgetRenderer.updateAll(context, "fc_sion_${source.lowercase().replace(' ', '_')}_finished")
+    }
+}
