+
+    /** Une fenêtre flottante Google qui mentionne FC Sion est déjà un signal fort :
+     * contrairement à une page de recherche normale, elle correspond au score épinglé. */
+    fun classifyPinnedScore(packageName: String, text: String): Signal {
+        if (!isGooglePackage(packageName)) return Signal.IGNORE
+        val normalized = normalize(text)
+        if (!mentionsFcSionBroad(normalized)) return Signal.IGNORE
+
+        val finished = listOf(
+            "match termine", "termine", "fin du match", "full time", "score final",
+            "apres prolongation", "apres les tirs au but"
+        ).any { normalized.contains(it) }
+        return if (finished) Signal.FINISHED else Signal.LIVE
+    }
+
     fun isGooglePackage(packageName: String): Boolean = packageName in setOf(
         "com.google.android.googlequicksearchbox",
         "com.google.android.apps.searchlite"
     )
 
+    private fun mentionsFcSionBroad(text: String): Boolean = text.contains("fc sion") || text.contains("sion")
+
     private fun mentionsFcSion(text: String): Boolean {
         if (text.contains("fc sion")) return true
         if (!text.contains("sion")) return false
