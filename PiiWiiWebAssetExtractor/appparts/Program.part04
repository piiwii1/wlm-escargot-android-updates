        if (string.IsNullOrWhiteSpace(sessionDir)) return null;
        await DownloadAllToSessionSilentlyAsync();
        var snapshot = SnapshotItems();
        var jsInteresting = await ScoreJsAsync(snapshot);
        var readme = new StringBuilder();
        readme.AppendLine("PIIWII CODE CAPTURE - PACK POUR CHATGPT");
        readme.AppendLine("======================================");
        readme.AppendLine($"URL analysée : {initialUrl}");
        readme.AppendLine($"Date : {sessionStarted:yyyy-M