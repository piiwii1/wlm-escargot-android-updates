ck.Click += (_, _) => { if (web.CanGoBack) web.GoBack(); };
        btnReload.Click += (_, _) => web.Reload();
        btnNoCache.Click += async (_, _) => await ReloadNoCacheAsync();
        btnDevTools.Click += (_, _) => web.CoreWebView2?.OpenDevToolsWindow();
        txtSearch.TextChanged += (_, _) => RefreshGrid();
        cmbType.SelectedIndexChanged += (_, _) => RefreshGrid();
        chkContinuous.CheckedChanged += (_, _) => captureEnabled = chkContinuous.Checked;
        grid.CellDoubleClick += async (_, _) => await DownloadSelectedAsync();
    }

