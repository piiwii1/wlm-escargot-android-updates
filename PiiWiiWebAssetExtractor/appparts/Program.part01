    private Control BuildLayout()
    {
        cmbType.Items.AddRange(new object[] { "Tous", "JS", "CSS", "JSON", "Images", "XHR", "HTML", "SVG", "Fonts", "Autres" });
        cmbType.SelectedIndex = 0;

        var root = new TableLayoutPanel { Dock = DockStyle.Fill, ColumnCount = 1, RowCount = 5, Padding = new Padding(18) };
        root.RowStyles.Add(new RowStyle(SizeType.AutoSize));
        root.RowStyles.Add(new RowStyle(SizeType.AutoSize));
        root.RowStyles.Add(new RowStyle(SizeType.Percent, 100));
        root.RowStyles.Add(new RowStyle(SizeType.AutoSize));
        root.RowStyles.Add(new RowStyle(SizeType.Absolute, 0));

        var header = new TableLayoutPanel { Dock = DockStyle.Top, AutoSize = true, ColumnCount = 2, Padding = new Padding(0, 0, 0, 10) };
        header.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 100));
        header.ColumnStyles.Add(new ColumnStyle(SizeType.AutoSize));
        var titleBlock = new FlowLayoutPanel { FlowDirection = FlowDirection.TopDown, WrapContents = false, AutoSize = true, Dock = DockStyle.Fill, Margin = new Padding(0) };
        titleBlock.Controls.Add(new Label { Text = "PiiWii Web Asset Extractor", AutoSize = true, Font = new Font("Segoe UI Semibold", 18f), ForeColor = Color.White, Margin = new Padding(0) });
        titleBlock.Controls.Add(new Label { Text = "Analyse une page et prépare directement les fichiers utiles pour ChatGPT.", AutoSize = true, ForeColor = Color.FromArgb(165, 170, 180), Margin = new Padding(1, 4, 0, 0) });
        header.Controls.Add(titleBlock, 0, 0);
        header.Controls.Add(btnSettings, 1, 0);

        var actionCard = new TableLayoutPanel { Dock = DockStyle.Top, AutoSize = true, ColumnCount = 1, Padding = new Padding(14), BackColor = Color.FromArgb(25, 28, 34), Margin = new Padding(0, 0, 0, 12) };
        var urlRow = new TableLayoutPanel { Dock = DockStyle.Top, AutoSize = true, ColumnCount = 2, Margin = new Padding(0, 0, 0, 8) };
        urlRow.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 100));
        urlRow.ColumnStyles.Add(new ColumnStyle(SizeType.AutoSize));
        urlRow.Controls.Add(txtUrl, 0, 0);
        urlRow.Controls.Add(btnFindCode, 1, 0);
        var targetRow = new FlowLayoutPanel { Dock = DockStyle.Top, AutoSize = true, WrapContents = true, Margin = new Padding(0, 8, 0, 0) };
        targetRow.Controls.Add(btnTargetStart);
        targetRow.Controls.Add(btnTargetDone);
        actionCard.Controls.Add(urlRow, 0, 0);
        actionCard.Controls.Add(targetRow, 0, 1);

        var browserWrap = new Panel { Dock = DockStyle.Fill, BackColor = Color.FromArgb(22, 24, 29), Padding = new Padding(1), Margin = new Padding(0, 0, 0, 10) };
        browserWrap.Controls.Add(web);

        var statusBar = new TableLayoutPanel { Dock = DockStyle.Top, AutoSize = true, ColumnCount = 2, Padding = new Padding(2, 8, 2, 0) };
        statusBar.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 100));
        statusBar.ColumnStyles.Add(new ColumnStyle(SizeType.AutoSize));
        var statusLeft = new FlowLayoutPanel { Dock = DockStyle.Fill, AutoSize = true, WrapContents = true };
        statusLeft.Controls.Add(lblStatus);
        statusLeft.Controls.Add(lblStats);
        statusBar.Controls.Add(statusLeft, 0, 0);
        statusBar.Controls.Add(new Label { Text = "Les captures sont enregistrées dans Documents\\PiiWii Web Extractor", AutoSize = true, ForeColor = Color.FromArgb(120, 125, 135), Padding = new Padding(0, 5, 0, 0) }, 1, 0);

        var advancedTools = new FlowLayoutPanel { Dock = DockStyle.Top, AutoSize = true, WrapContents = true, Padding = new Padding(0, 0, 0, 8) };
        advancedTools.Controls.AddRange(new Control[] { btnBack, btnReload, btnNoCache, btnDevTools, chkNoCache, chkContinuous, txtSearch, cmbType, btnAnalyze, btnDownload, btnDownloadAll, btnHar, btnCopyUrl, btnEngine, btnMark, btnPack });
        advancedPanel.Controls.Add(grid);
        advancedPanel.Controls.Add(advancedTools);
        advancedTools.BringToFront();

        root.Controls.Add(header, 0, 0);
        root.Controls.Add(actionCard, 0, 1);
        root.Controls.Add(browserWrap, 0, 2);
        root.Controls.Add(statusBar, 0, 3);
        root.Controls.Add(advancedPanel, 0, 4);

        advancedPanel.VisibleChanged += (_, _) =>
        {
            root.RowStyles[4].Height = advancedPanel.Visible ? 280 : 0;
        };
        return root;
    }

    private void BuildGrid()
    {
        grid.ColumnHeadersDefaultCellStyle.BackColor = Color.FromArgb(34, 37, 43);
        grid.ColumnHeadersDefaultCellStyle.ForeColor = Color.White;
        grid.DefaultCellStyle.BackColor = Color.FromArgb(23, 25, 30);
        grid.DefaultCellStyle.ForeColor = Color.Gainsboro;
        grid.DefaultCellStyle.SelectionBackColor = Color.FromArgb(45, 86, 145);
        grid.EnableHeadersVisualStyles = false;
        grid.Columns.Add(new DataGridViewTextBoxColumn { HeaderText = "Type", DataPropertyName = nameof(ResourceItem.ResourceType), Width = 75 });
        grid.Columns.Add(new DataGridViewTextBoxColumn { HeaderText = "Fichier", DataPropertyName = nameof(ResourceItem.FileName), Width = 310 });
        grid.Columns.Add(new DataGridViewTextBoxColumn { HeaderText = "Statut", DataPropertyName = nameof(ResourceItem.Status), Width = 70 });
        grid.Columns.Add(new DataGridViewTextBoxColumn { HeaderText = "Taille", DataPropertyName = nameof(ResourceItem.Size), Width = 95 });
        grid.Columns.Add(new DataGridViewTextBoxColumn { HeaderText = "Domaine", DataPropertyName = nameof(ResourceItem.Domain), Width = 180 });
        grid.Columns.Add(new DataGridViewTextBoxColumn { HeaderText = "URL", DataPropertyName = nameof(ResourceItem.Url), AutoSizeMode = DataGridViewAutoSizeColumnMode.Fill });
    }

    private async Task InitializeAsync()
    {
        try
        {
            Directory.CreateDirectory(Log.Root);
            var userData = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), "PiiWii", "WebAssetExtractor", "WebView2");
            var env = await CoreWebView2Environment.CreateAsync(null, userData);
            await web.EnsureCoreWebView2Async(env);
            web.CoreWebView2.Settings.AreDevToolsEnabled = true;
            web.CoreWebView2.Settings.AreDefaultContextMenusEnabled = true;
            web.CoreWebView2.Settings.IsStatusBarEnabled = false;
            web.CoreWebView2.NavigationCompleted += (_, e) => SetStatus(e.IsSuccess ? "🟢 Page chargée" : "🔴 Échec de navigation");
            await HookNetworkAsync();
            initialized = true;
            SetStatus("🟢 Prêt — colle une adresse puis lance l'analyse");
        }
        catch (Exception ex)
        {
            Log.Write("INIT", ex);
            MessageBox.Show("WebView2 n'a pas pu démarrer. Vérifie que Microsoft Edge WebView2 Runtime est installé.\n\n" + ex.Message,
                "PiiWii Web Asset Extractor", MessageBoxButtons.OK, MessageBoxIcon.Error);
            SetStatus("🔴 WebView2 indisponible");
        }
    }

    private async Task HookNetworkAsync()
    {
        if (web.CoreWebView2 is null) return;
        await web.CoreWebView2.CallDevToolsProtocolMethodAsync("Network.enable", "{}");

        requestReceiver = web.CoreWebView2.GetDevToolsProtocolEventReceiver("Network.requestWillBeSent");
        responseReceiver = web.CoreWebView2.GetDevToolsProtocolEventReceiver("Network.responseReceived");
        finishedReceiver = web.CoreWebView2.GetDevToolsProtocolEventReceiver("Network.loadingFinished");

        requestReceiver.DevToolsProtocolEventReceived += OnRequestWillBeSent;
        responseReceiver.DevToolsProtocolEv