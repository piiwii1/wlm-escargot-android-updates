        String code=prefs.get("code",""); if(code.isEmpty())return;
        LinearLayout box=new LinearLayout(this);box.setOrientation(LinearLayout.VERTICAL);box.setGravity(Gravity.CENTER_HORIZONTAL);box.setPadding(dp(18),dp(8),dp(18),dp(8));
        QrCodeView qr=new QrCodeView(this);qr.setPayload("modeconvoi://join/"+code);box.addView(qr,new LinearLayout.LayoutParams(dp(280),dp(280)));
        TextView c=text(code,24,true,Color.rgb(20,25,30));c.setGravity(Gravity.CENTER);box.addView(c,new LinearLayout.LayoutParams(-1,dp(48)));
        new AlertDialog.Builder(this).setTitle("Rejoindre le convoi").setMessage("Scanner ce QR avec un autre téléphone ou utiliser le code.").setView(box).setPositiveButton("Fermer",null).show();
    }
