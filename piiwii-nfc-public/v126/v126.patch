+    private boolean loadUriIntoEditor(Uri uri) {
+        if (uri == null) return false;
+        String raw = uri.toString();
+        String scheme = uri.getScheme() == null ? "" : uri.getScheme().toLowerCase(Locale.ROOT);
+        emailSubjectInput.setText("");
+        messageBodyInput.setText("");
+
+        if ("tel".equals(scheme)) {
+            typeGroup.check(R.id.typePhone);
+            payloadInput.setText(decodeTargetPart(raw));
+            return true;
+        }
+        if ("mailto".equals(scheme)) {
+            typeGroup.check(R.id.typeEmail);
+            payloadInput.setText(decodeTargetPart(raw));
+            emailSubjectInput.setText(extractQueryValue(raw, "subject"));
+            messageBodyInput.setText(extractQueryValue(raw, "body"));
+            return true;
+        }
+        if ("sms".equals(scheme) || "smsto".equals(scheme)) {
+            typeGroup.check(R.id.typeSms);
+            payloadInput.setText(decodeTargetPart(raw));
+            messageBodyInput.setText(extractQueryValue(raw, "body"));
+            return true;
+        }
+        typeGroup.check(R.id.typeUrl);
+        payloadInput.setText(raw);
+        return true;
+    }
+
+    private String decodeTargetPart(String rawUri) {
+        if (TextUtils.isEmpty(rawUri)) return "";
+        int colon = rawUri.indexOf(':');
+        String value = colon >= 0 ? rawUri.substring(colon + 1) : rawUri;
+        int query = value.indexOf('?');
+        if (query >= 0) value = value.substring(0, query);
+        return Uri.decode(value);
+    }
+
+    private String extractQueryValue(String rawUri, String wantedKey) {
+        if (TextUtils.isEmpty(rawUri) || TextUtils.isEmpty(wantedKey)) return "";
+        int query = rawUri.indexOf('?');
+        if (query < 0 || query + 1 >= rawUri.length()) return "";
+        String[] pairs = rawUri.substring(query + 1).split("&");
+        for (String pair : pairs) {
+            int equals = pair.indexOf('=');
+            String key = equals >= 0 ? pair.substring(0, equals) : pair;
+            if (!wantedKey.equalsIgnoreCase(Uri.decode(key))) continue;
+            String value = equals >= 0 ? pair.substring(equals + 1) : "";
+            return Uri.decode(value.replace("+", "%20"));
+        }
+        return "";
     }
 
