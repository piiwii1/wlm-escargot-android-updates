+    private void updateReadResult(NdefMessage message, String decoded) {
+        lastDecodedContent = decoded == null ? "" : decoded;
+        readContentText.setText(lastDecodedContent.isEmpty() ? "(Tag vide)" : lastDecodedContent);
+        copyContentButton.setVisibility(lastDecodedContent.isEmpty() ? View.GONE : View.VISIBLE);
+        lastActionUri = null;
+        actionButton.setVisibility(View.GONE);
+        if (message == null) return;
+        for (NdefRecord r : message.getRecords()) {
+            if (r.getTnf() == NdefRecord.TNF_WELL_KNOWN && Arrays.equals(r.getType(), NdefRecord.RTD_URI)) {
+                Uri uri = r.toUri();
+                if (uri == null) continue;
+                lastActionUri = uri;
+                String scheme = uri.getScheme() == null ? "" : uri.getScheme().toLowerCase(Locale.ROOT);
+                if ("tel".equals(scheme)) actionButton.setText("APPELER");
+                else if ("mailto".equals(scheme)) actionButton.setText("OUVRIR L’E-MAIL");
+                else if ("sms".equals(scheme) || "smsto".equals(scheme)) actionButton.setText("OUVRIR LE SMS");
+                else actionButton.setText("OUVRIR LE LIEN");
+                actionButton.setVisibility(View.VISIBLE);
+                break;
+            }
+        }
+    }
+
