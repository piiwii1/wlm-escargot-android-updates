<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="13dp"
    android:paddingRight="13dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GOOGLE MAPS"
                android:textColor="#91A9BC"
                android:textStyle="bold"
                android:textSize="9sp"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="@drawable/widget_chip"
                android:text="LIVE"
                android:textColor="#A5F7FF"
                android:textStyle="bold"
                android:textSize="8sp"
                android:letterSpacing="0.08"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:background="@drawable/nav_icon_plate"
                android:padding="6dp">

                <ImageView
                    android:id="@+id/widget_arrow"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="Manœuvre de navigation" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="13dp"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_distance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="100 m"
                    android:textColor="#8BF4FF"
                    android:textStyle="bold"
                    android:textSize="30sp"
                    android:maxLines="1"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_instruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="Tournez à gauche"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="19sp"
                    android:lineSpacingExtra="-1dp"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Rue de Lausanne"
                    android:textColor="#8198AB"
                    android:textSize="11sp"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_trip_metrics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@drawable/trip_metric_bg">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ARRIVÉE"
                android:textColor="#7E9AAF"
                android:textStyle="bold"
                android:textSize="8sp"
                android:letterSpacing="0.08"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/widget_eta_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="13:54"
                android:textColor="#F8FCFF"
                android:textStyle="bold"
                android:textSize="16sp"
                android:maxLines="1"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@drawable/trip_metric_bg">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISTANCE"
                android:textColor="#7E9AAF"
                android:textStyle="bold"
                android:textSize="8sp"
                android:letterSpacing="0.08"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/widget_trip_distance_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="18,6 km"
                android:textColor="#8BF4FF"
                android:textStyle="bold"
                android:textSize="16sp"
                android:maxLines="1"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@drawable/trip_metric_bg">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DURÉE"
                android:textColor="#7E9AAF"
                android:textStyle="bold"
                android:textSize="8sp"
                android:letterSpacing="0.08"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/widget_trip_duration_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="24 min"
                android:textColor="#F8FCFF"
                android:textStyle="bold"
                android:textSize="16sp"
                android:maxLines="1"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
