<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/widget_arrow"
        android:layout_width="76dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="↑"
        android:textColor="#79E38A"
        android:textStyle="bold"
        android:textSize="52sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_distance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="100 m"
            android:textColor="#79E38A"
            android:textStyle="bold"
            android:textSize="21sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_instruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Tournez à gauche"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/widget_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Rue de Lausanne"
            android:textColor="#D9DEE5"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
