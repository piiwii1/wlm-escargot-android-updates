<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/widget_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="● GOOGLE MAPS"
        android:textColor="#79E38A"
        android:textStyle="bold"
        android:textSize="10sp"
        android:letterSpacing="0.08"
        android:maxLines="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="7dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:background="@drawable/nav_icon_plate"
            android:padding="5dp">

            <ImageView
                android:id="@+id/widget_arrow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="Manœuvre de navigation" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_distance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="100 m"
                android:textColor="#79E38A"
                android:textStyle="bold"
                android:textSize="22sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_instruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="Tournez à gauche"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/widget_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Rue de Lausanne"
                android:textColor="#AEB8C4"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
