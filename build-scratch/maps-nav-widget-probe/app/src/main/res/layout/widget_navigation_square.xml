<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/square_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/square_meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GOOGLE MAPS"
            android:textColor="#8EA4B8"
            android:textStyle="bold"
            android:textSize="10sp"
            android:letterSpacing="0.06"
            android:maxLines="1" />

        <TextView
            android:id="@+id/square_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingLeft="9dp"
            android:paddingRight="9dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/widget_chip"
            android:text="LIVE"
            android:textColor="#9CF5FF"
            android:textStyle="bold"
            android:textSize="9sp"
            android:letterSpacing="0.08" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/nav_icon_plate"
        android:padding="5dp">

        <ImageView
            android:id="@+id/square_arrow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Manœuvre de navigation" />
    </FrameLayout>

    <TextView
        android:id="@+id/square_distance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="100 m"
        android:textColor="#82F4FF"
        android:textStyle="bold"
        android:textSize="34sp"
        android:maxLines="1"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/square_instruction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Tournez à gauche"
        android:textColor="#F7FBFF"
        android:textStyle="bold"
        android:textSize="20sp"
        android:lineSpacingExtra="-1dp"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/square_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Rue de Lausanne"
        android:textColor="#8195A8"
        android:textSize="12sp"
        android:includeFontPadding="false" />
</LinearLayout>
