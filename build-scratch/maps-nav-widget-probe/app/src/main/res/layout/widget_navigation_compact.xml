<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="11dp"
    android:paddingRight="11dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="@drawable/widget_bg">

    <FrameLayout
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:background="@drawable/nav_icon_plate"
        android:padding="5dp">

        <ImageView
            android:id="@+id/widget_arrow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Manœuvre de navigation" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_distance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="100 m"
            android:textColor="#8BF4FF"
            android:textStyle="bold"
            android:textSize="22sp"
            android:maxLines="1"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_instruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Tournez à gauche"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:lineSpacingExtra="-1dp"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Rue de Lausanne"
            android:textColor="#7F95A8"
            android:textSize="10sp"
            android:includeFontPadding="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:orientation="vertical"
        android:gravity="top|end">

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/widget_chip"
            android:text="LIVE"
            android:textColor="#A5F7FF"
            android:textStyle="bold"
            android:textSize="8sp"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="MAPS"
            android:textColor="#70879A"
            android:textStyle="bold"
            android:textSize="8sp"
            android:includeFontPadding="false" />
    </LinearLayout>
</LinearLayout>
