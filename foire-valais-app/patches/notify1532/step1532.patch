     void createChannel(){if(Build.VERSION.SDK_INT>=26)((NotificationManager)getSystemService(NOTIFICATION_SERVICE)).createNotificationChannel(new NotificationChannel(EventReceiver.CHANNEL,"Mes événements Foire",NotificationManager.IMPORTANCE_HIGH));}
+
+    void testNotification(){
+        if(Build.VERSION.SDK_INT>=33 && checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS)!=PackageManager.PERMISSION_GRANTED){
+            requestPermissions(new String[]{Manifest.permission.POST_NOTIFICATIONS},51);
+            return;
+        }
+        showTestNotification();
+    }
+
+    void showTestNotification(){
+        createChannel();
+        NotificationManager nm=(NotificationManager)getSystemService(NOTIFICATION_SERVICE);
+        Intent open=new Intent(this,MainActivity.class).addFlags(Intent.FLAG_ACTIVITY_CLEAR_TOP|Intent.FLAG_ACTIVITY_SINGLE_TOP);
+        PendingIntent pi=PendingIntent.getActivity(this,1532,open,PendingIntent.FLAG_IMMUTABLE|PendingIntent.FLAG_UPDATE_CURRENT);
+        Notification.Builder b=Build.VERSION.SDK_INT>=26?new Notification.Builder(this,EventReceiver.CHANNEL):new Notification.Builder(this);
+        b.setSmallIcon(R.drawable.ic_launcher)
+                .setContentTitle("Bientôt : Notification test")
+                .setContentText("Voilà à quoi ressemblera un rappel de la Foire du Valais.")
+                .setAutoCancel(true)
+                .setContentIntent(pi)
+                .setCategory(Notification.CATEGORY_EVENT)
+                .setPriority(Notification.PRIORITY_HIGH);
+        nm.notify(1532,b.build());
+        Toast.makeText(this,"Notification test envoyée",Toast.LENGTH_SHORT).show();
+    }
+
+    @Override public void onRequestPermissionsResult(int requestCode,String[] permissions,int[] grantResults){
+        super.onRequestPermissionsResult(requestCode,permissions,grantResults);
+        if(requestCode==51){
+            if(grantResults.length>0 && grantResults[0]==PackageManager.PERMISSION_GRANTED) showTestNotification();
+            else Toast.makeText(this,"Autorise les notifications Android pour afficher le test.",Toast.LENGTH_LONG).show();
+        }
+    }
